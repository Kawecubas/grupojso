# URL pública del sitio (para metadatos, sitemap y Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.grupojso.com

# Envío del formulario de contacto por SMTP (opcional).
# Si no se configuran, los mensajes se registran en la consola del servidor.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACTO_DESTINO=info@grupojso.com
